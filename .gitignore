# Variáveis de ambiente e segredos
.env
api/.env

# Sistema Operacional
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Logs
*.log
logs/

# Rotas dinâmicas temporárias
data/routes/*.json
!data/routes/.gitkeep

# Stable persistence locks and interrupted atomic writes (never serve data/).
data/.store.lock
data/routes/.write-*

# Native OAuth sessions contain server-side tokens; never version or serve them.
/data/sessions/

# Persisted planning snapshots are operational data, not source fixtures.
/data/routines/*.json
/data/routines/.write-*
