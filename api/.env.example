# Chave de API Google Gemini (Vision e IA)
# Obtenha sua chave em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui

# OAuth2 Nextcloud (sem OIDC). Client ID deve ser o identificador real cadastrado.
GED_AUTH_TYPE=oauth2
GED_BASE_URL=https://ged.plaswill.tech
GED_CLIENT_ID=plaswill-entregas
GED_CLIENT_SECRET=
GED_REDIRECT_URI=https://entregas.plaswill.tech/api/auth_callback.php
ENTREGAS_PUBLIC_ORIGIN=https://entregas.plaswill.tech
# Grupos cumulativos: Diretoria/admin têm administração; Comercial/Financeiro somente leitura.
ENTREGAS_ROLE_GROUPS='{"operator":["Logistica","Producao","admin"],"supervisor":["Comercial","Diretoria","Financeiro"],"administrator":["admin","Diretoria"]}'
# GED_INTERNAL_URL não é usado: tokens e identidade são consultados somente via HTTPS.
